{
  "name": "icalingua-plus-plus",
  "workspaces": [
    "icalingua",
    "icalingua-bridge-oicq",
    "packages/*"
  ],
  "dependencies": {
    "@actions/core": "1.11.1",
    "@icalingua/storage-providers": "workspace:*",
    "@icalingua/types": "workspace:*",
    "icalingua": "workspace:*",
    "icalingua-bridge-oicq": "workspace:*"
  },
  "packageManager": "pnpm@10.34.4",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "scripts": {
    "prepare": "husky install"
  },
  "lint-staged": {
    "icalingua/**/*": [
      "prettier --write"
    ],
    "icalingua-bridge-oicq/**/*": [
      "prettier --write"
    ],
    "packages/**/*": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "neverBuiltDependencies": [],
    "overrides": {
      "negotiator": "0.6.4",
      "node-gyp": "12.4.0"
    }
  }
}
