    "scripts": {
        "start": "node build",
        "build": "node build.mjs",
        "compile": "echo \"[DEPRECATED] pnpm compile is deprecated - use pnpm build instead.\" && tsc --build --verbose && cp -af ./static ./build/ && pnpm copy-packages",
        "compile:win": "echo \"[DEPRECATED] pnpm compile:win is deprecated - use pnpm build instead.\" && tsc --build --verbose && xcopy /e .\\static\\ .\\build\\static\\ && pnpm copy-packages:win",
        "copy-packages": "mkdir -p ./build/node_modules/@icalingua/storage-providers ./build/node_modules/@icalingua/types ./build/@icalingua && cp -af ../packages/storageProviders/build/. ./build/node_modules/@icalingua/storage-providers/ && cp -af ../packages/types/build/. ./build/node_modules/@icalingua/types/ && cp -af ./build/node_modules/@icalingua/. ./build/@icalingua/",
        "copy-packages:win": "mkdir .\\build\\node_modules && mkdir .\\build\\node_modules\\@icalingua && xcopy /e ..\\packages\\storageProviders\\build\\ .\\build\\node_modules\\@icalingua\\storage-providers\\ && xcopy /e ..\\packages\\types\\build\\ .\\build\\node_modules\\@icalingua\\types\\ && xcopy /e .\\build\\node_modules\\@icalingua\\ .\\build\\@icalingua\\",
        "detach-start": "screen -U pnpm start",
        "dev": "NODE_ENV=development ts-node ."
    },
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/md5": "^2.3.6",
        "@types/node": "^22.20.0",
        "@types/ws": "^8.18.1",
        "esbuild": "^0.25.12",
