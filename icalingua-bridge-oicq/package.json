        "@saltify/milky-types": "1.2.0-rc.4",
        "axios": "^1.18.1",
        "better-sqlite3": "13.0.3",
        "body-parser": "^1.20.6",
        "eventemitter3": "^5.0.4",
        "eventsource": "^4.1.0",
        "express": "^4.22.2",
        "ioredis": "^4.31.0",
        "knex": "^2.5.1",
        "lodash": "^4.18.1",
        "md5": "^2.3.0",
        "minimist": "^1.2.8",
        "mongodb": "^4.17.2",
        "mysql": "^2.18.1",
        "oicq-icalingua-plus-plus": "^1.26.22",
        "pg": "^8.22.0",
