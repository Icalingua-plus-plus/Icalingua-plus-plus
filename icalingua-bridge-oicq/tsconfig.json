{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2022",
        "lib": ["ES2022"],
        "esModuleInterop": true,
        "sourceMap": false,
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "outDir": "build",
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "build"],
    "references": [
        {
            "path": "../packages/storageProviders"
        },
        {
            "path": "../packages/types"
        }
    ]
}
