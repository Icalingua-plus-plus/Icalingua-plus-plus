{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "esModuleInterop": true,
        "sourceMap": false,
        "resolveJsonModule": true,
        "moduleResolution": "Node",
        "skipLibCheck": true,
        "strict": false,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/renderer/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "build"]
}
